{
  "manifest_version": 3,
  "name": "Chess.com Real-Time Engine Assistant",
  "version": "1.0.1",
  "description": "Real-time board analysis, Stockfish evaluation, and visual move suggestions overlay for Chess.com",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.chess.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "all_frames": true,
      "css": ["content/overlay.css"],
      "js": [
        "engine/stockfish.js",
        "content/parser.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine/stockfish.js",
        "content/overlay.css"
      ],
      "matches": ["https://www.chess.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
